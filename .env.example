APP_NAME="Ruci Notaria"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://notaria.domainanda.co.id
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL dari cPanel (format nama biasanya: userCpanel_namadb)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_notaria
DB_USERNAME=cpaneluser_notaria
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email cPanel (opsional, untuk reset kata sandi)
MAIL_MAILER=smtp
MAIL_HOST=mail.domainanda.co.id
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=noreply@domainanda.co.id
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@domainanda.co.id"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Ruci Notaria ----
# MFA (aplikasi autentikator). true = wajib bagi semua akun. Sangat disarankan untuk produksi.
NOTARIA_MFA_REQUIRED=false
# Ukuran unggahan maksimum (KB). Pastikan upload_max_filesize dan post_max_size PHP tidak lebih kecil.
NOTARIA_MAX_UPLOAD_KB=20480

# Akun notaris pertama dibuat saat "php artisan migrate --seed" bila diisi.
NOTARIA_ADMIN_EMAIL=
NOTARIA_ADMIN_PASSWORD=

# Data contoh kantor notaris fiktif. Matikan untuk produksi.
NOTARIA_DEMO=false
NOTARIA_DEMO_PASSWORD="Demo#2026notaria"

# ---- AI (OpenAI) ----
# Kosongkan bila tidak memakai AI. Walau terisi, fitur AI tetap mati sampai notaris menyalakannya di Pengaturan Kantor.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=90
# Tarif per 1 juta token (USD) untuk memperkirakan biaya; sesuaikan dengan tarif model yang dipakai.
OPENAI_PRICE_INPUT=0.25
OPENAI_PRICE_OUTPUT=2.0
